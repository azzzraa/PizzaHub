generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pizza {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String
  available   Boolean @default(true)
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("customer")
  createdAt DateTime @default(now())
}